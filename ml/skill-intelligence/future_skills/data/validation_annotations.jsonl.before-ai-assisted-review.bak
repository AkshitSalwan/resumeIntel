r similar infrastructure and observability tooling About O"},{"name":"Distributed Systems","canonical_id":"distributed-systems","evidence":"t thrive in this role if you: - Have experience building or operating distributed systems in production - Have worked on storage infrastructure, object stores,"}],"unresolved_skills":[]},"reviewer_decision":"candidate","corrected_output":null,"review_notes":null,"reviewer":null,"split":"validation","provenance":{"source_job_id":"7649205e-20dc-4bb4-9358-69474a851132","source_url":"https://jobs.ashbyhq.com/openai/7649205e-20dc-4bb4-9358-69474a851132","collection_timestamp":"2026-11-11T07:10:43.006128Z","taxonomy":"forecasting.taxonomy.skill_dictionary.INITIAL_SKILLS","source_record_ids":["7cdf2ff0-9b2f-5e2d-ac6b-1615f364c5d9"],"source_ids":["ashby"]}}
