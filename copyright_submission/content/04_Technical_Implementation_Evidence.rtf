{\rtf1\ansi\deff0{\fonttbl{\f0 Times New Roman;}{\f1 Courier New;}}{\colortbl;\red32\green45\blue70;\red92\green77\blue212;}\paperw11906\paperh16838\margl1440\margr1440\margt1260\margb1260\widowctrl\viewkind4{\header{\pard\qr\fs18 ResumeIntel | Copyright submission\par}}{\footer{\pard\qc\fs18 Page \chpgn\par}}{\pard\fs34\b\qc\sb300\sa220 TECHNICAL IMPLEMENTATION EVIDENCE\par}{\pard\fs22\qc\sa300 Selected source excerpts, authentic screenshots and verification record\par}\page {\pard\fs26\b\sb360\sa160 1. Evidence inventory\par}{\pard\fs24\sa140\sl276\slmult1 The excerpts below are copied directly from the repository and are accompanied by their source locations. Line numbers in snippet files refer to the source line at capture time (1-based). The excerpts are evidence of implementation, not proof of exclusive ownership or performance.\par}{\pard\fs26\b\sb360\sa160 2. Core implementation excerpts\par}{\pard\fs20\b\sb220\sa100 1. 01_resume_validation.ts\par}{\pard\fs19\sa100 Source: lib/resume-extraction.ts, lines 1\u8211?35\par}{\pard\fs24\sa140\sl276\slmult1 File constraints, supported MIME types, size limit, and PDF/ZIP signature checks. Prevents trusting filename or MIME claims alone at the upload boundary.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0001  import \{ normalizeText \} from './analysis'\line 0002\line 0003  export const MAX_RESUME_BYTES = 10 * 1024 * 1024\line 0004  export const SUPPORTED_RESUME_TYPES = [\line 0005    'application/pdf',\line 0006    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\line 0007  ] as const\line 0008\line 0009  export type SupportedResumeType = (typeof SUPPORTED_RESUME_TYPES)[number]\line 0010\line 0011  export function validateResumeFile(file: Pick<File, 'name' | 'size' | 'type'>) \{\line 0012    if (!SUPPORTED_RESUME_TYPES.includes(file.type as SupportedResumeType)) \{\line 0013      return \{ ok: false as const, error: 'Only PDF and DOCX resumes are supported.' \}\line 0014    \}\line 0015    if (file.size === 0) return \{ ok: false as const, error: 'The resume file is empty.' \}\line 0016    if (file.size > MAX_RESUME_BYTES) return \{ ok: false as const, error: 'Resume must be 10 MB or smaller.' \}\line 0017    return \{ ok: true as const \}\line 0018  \}\line 0019\line 0020  export function hasValidFileSignature(type: string, buffer: Buffer) \{\line 0021    if (type === 'application/pdf') return buffer.subarray(0, 5).toString('ascii') === '%PDF-'\line 0022    if (type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') \{\line 0023      return buffer.subarray(0, 2).toString('hex') === '504b'\line 0024    \}\line 0025    return false\line 0026  \}\line 0027\line 0028  export function normalizeExtractedResumeText(text: string) \{\line 0029    return normalizeText(text).replace(/\\u0000/g, '')\line 0030  \}\line 0031\line 0032  export function assertReadableResumeText(text: string) \{\line 0033    const normalized = normalizeExtractedResumeText(text)\line 0034    if (normalized.length < 40) throw new Error('The resume did not contain enough readable text.')\line 0035    return normalized\line \par}{\pard\fs20\b\sb220\sa100 2. 02_resume_text_extraction.ts\par}{\pard\fs19\sa100 Source: lib/resume-extraction.ts, lines 37\u8211?65\par}{\pard\fs24\sa140\sl276\slmult1 PDF.js and Mammoth extraction, normalization, readable-text threshold, and parser cleanup. Shows server-side parsing of the two supported document formats.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0037\line 0038  export async function extractResumeText(type: SupportedResumeType, buffer: Buffer) \{\line 0039    if (!hasValidFileSignature(type, buffer)) throw new Error('The file signature does not match its declared type.')\line 0040    if (type === 'application/pdf') \{\line 0041      const \{ getDocument \} = await import('pdfjs-dist/legacy/build/pdf.mjs')\line 0042      const document = await getDocument(\{\line 0043        data: new Uint8Array(buffer),\line 0044        isEvalSupported: false,\line 0045      \}).promise\line 0046      try \{\line 0047        const pages: string[] = []\line 0048        for (let pageNumber = 1; pageNumber <= document.numPages; pageNumber += 1) \{\line 0049          const page = await document.getPage(pageNumber)\line 0050          const content = await page.getTextContent()\line 0051          pages.push(content.items.map((item) => 'str' in item ? item.str : '').join(' '))\line 0052        \}\line 0053        return assertReadableResumeText(pages.join('\\n'))\line 0054      \} finally \{\line 0055        await document.cleanup()\line 0056        await document.destroy()\line 0057      \}\line 0058    \}\line 0059    const mammoth = await import('mammoth')\line 0060    return assertReadableResumeText((await mammoth.extractRawText(\{ buffer \})).value)\line 0061  \}\line 0062\line 0063  export function isSupportedResumeType(type: string): type is SupportedResumeType \{\line 0064    return SUPPORTED_RESUME_TYPES.includes(type as SupportedResumeType)\line 0065  \}\line \par}{\pard\fs20\b\sb220\sa100 3. 03_alias_taxonomy_and_normalization.ts\par}{\pard\fs19\sa100 Source: lib/analysis.ts, lines 49\u8211?108\par}{\pard\fs24\sa140\sl276\slmult1 Versioned canonical IDs, explicit aliases, NFKC normalization, and complete-term matching boundaries. Makes terminology normalization deterministic and inspectable.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0049  export const TAXONOMY_VERSION = '2026-10-11'\line 0050\line 0051  /**\line 0052   * Canonical skill IDs and their explicit, complete-term aliases.\line 0053   * Related technologies are intentionally separate unless listed together.\line 0054   */\line 0055  export const aliases: Record<string, string[]> = \{\line 0056    javascript: ['javascript', 'js', 'ecmascript'],\line 0057    react: ['react', 'react.js', 'reactjs'],\line 0058    typescript: ['typescript', 'ts'],\line 0059    next: ['next.js', 'nextjs', 'next js'],\line 0060    node: ['node.js', 'nodejs', 'node'],\line 0061    postgresql: ['postgresql', 'postgres'],\line 0062    testing: ['testing', 'jest', 'vitest', 'playwright'],\line 0063    accessibility: ['accessibility', 'wcag', 'aria'],\line 0064    python: ['python'],\line 0065    sql: ['sql'],\line 0066    aws: ['aws', 'amazon web services'],\line 0067    kubernetes: ['kubernetes', 'k8s'],\line 0068  \}\line 0069\line 0070  const categoryBySkill: Record<string, RequirementCategory> = \{\line 0071    javascript: 'technical skill',\line 0072    react: 'technical skill',\line 0073    typescript: 'technical skill',\line 0074    next: 'tool',\line 0075    node: 'tool',\line 0076    postgresql: 'tool',\line 0077    testing: 'technical skill',\line 0078    accessibility: 'qualification',\line 0079    python: 'technical skill',\line 0080    sql: 'technical skill',\line 0081    aws: 'tool',\line 0082    kubernetes: 'tool',\line 0083  \}\line 0084\line 0085  export const scoreDefinition = 'A deterministic, weighted job-description match score based on resume evidence. Required requirements have weight 5, preferred requirements have weight 3, and the existing documented credits are matched 1.00, partial 0.55, uncertain 0.35, and missing 0.00. It is not an employer ATS score, hiring probability, or interview prediction.'\line 0086  export const SCORE_WEIGHTS = \{ matched: 1, partial: 0.55, uncertain: 0.35, missing: 0 \} as const\line 0087  export const MAX_JOB_DESCRIPTION_LENGTH = 20000\line 0088\line 0089  export function validateJobDescription(value: string) \{\line 0090    const normalized = normalizeText(value)\line 0091    if (!normalized) return \{ ok: false as const, error: 'A job description is required.' \}\line 0092    if (normalized.length > MAX_JOB_DESCRIPTION_LENGTH) return \{ ok: false as const, error: 'Job descriptions must be 20,000 characters or fewer.' \}\line 0093    if (normalized.replace(/[\\W_]/g, '').length < 20) return \{ ok: false as const, error: 'The job description does not contain enough readable content.' \}\line 0094    return \{ ok: true as const, value: normalized \}\line 0095  \}\line 0096\line 0097  export function normalizeText(text: string) \{\line 0098    return text.normalize('NFKC').replace(/[\\t ]+/g, ' ').replace(/\\n\{3,\}/g, '\\n\\n').trim()\line 0099  \}\line 0100\line 0101  function escapeRegExp(value: string) \{\line 0102    return value.replace(/[.*+?^$\{\}()|[\\]\\\\]/g, '\\\\$&')\line 0103  \}\line 0104\line 0105  function termPattern(term: string) \{\line 0106    const prefix = term.length <= 2 ? '(?<![A-Za-z0-9.])' : '(?<![A-Za-z0-9])'\line 0107    return new RegExp(`$\{prefix\}$\{escapeRegExp(term)\}(?![A-Za-z0-9])`, 'i')\line 0108  \}\line \par}{\pard\fs20\b\sb220\sa100 4. 04_requirement_extraction.ts\par}{\pard\fs19\sa100 Source: lib/analysis.ts, lines 238\u8211?280\par}{\pard\fs24\sa140\sl276\slmult1 Recognized requirements are extracted from lines; unsupported bullet requirements are retained with stable unmapped IDs. Preserves requirements that the narrow taxonomy cannot confidently classify.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0238  export function extractRequirements(jobDescription: string): Requirement[] \{\line 0239    const normalized = normalizeText(jobDescription)\line 0240    const lines = splitLines(normalized)\line 0241    const requirements: Requirement[] = []\line 0242    const seen = new Set<string>()\line 0243    const importanceFor = (context: string): Requirement['importance'] =>\line 0244      /preferred|nice to have|bonus|plus|optional/i.test(context) ? 'preferred' : 'required'\line 0245    const addRequirement = (id: string, importance: Requirement['importance'], sourceText: string, uncertain = false, label = labelFor(id)) => \{\line 0246      if (seen.has(id)) return\line 0247      seen.add(id)\line 0248      requirements.push(\{\line 0249        id,\line 0250        label,\line 0251        requirementText: sourceText,\line 0252        normalizedName: uncertain ? undefined : label,\line 0253        category: requirementCategory(id, sourceText),\line 0254        importance,\line 0255        weight: importance === 'required' ? 5 : 3,\line 0256        status: uncertain ? 'uncertain' : 'missing',\line 0257        sourceText,\line 0258        method: uncertain ? 'unmapped job-description requirement' : 'recognized taxonomy alias',\line 0259        explanation: uncertain ? 'This requirement appears in the job description but is not mapped to the supported skill taxonomy.' : undefined,\line 0260      \})\line 0261    \}\line 0262\line 0263    for (const line of lines) \{\line 0264      const importance = importanceFor(line)\line 0265      const skills = extractSkills(line)\line 0266      for (const id of skills) addRequirement(id, importance, line)\line 0267      if (/^[-*\u8226?]\\s+/.test(line) && !skills.length) \{\line 0268        const label = line.replace(/^[-*\u8226?]\\s+/, '').replace(/[.:]+$/, '').trim()\line 0269        if (label.split(/\\s+/).length >= 2) addRequirement(stableUnmappedId(label), importance, line, true, label)\line 0270      \}\line 0271    \}\line 0272    if (!requirements.length) \{\line 0273      for (const id of extractSkills(normalized)) addRequirement(id, importanceFor(normalized), normalized)\line 0274    \}\line 0275    return requirements.map((item) => \{\line 0276      if (item.id.startsWith('unmapped:')) return item\line 0277      const context = lines.find((line) => aliases[item.id].some((term) => termPattern(term).test(line))) ?? normalized\line 0278      const importance = importanceFor(context)\line 0279      return \{ ...item, requirementText: context, sourceText: context, importance, weight: importance === 'required' ? 5 : 3 \}\line 0280    \})\line \par}{\pard\fs20\b\sb220\sa100 5. 05_evidence_classification.ts\par}{\pard\fs19\sa100 Source: lib/analysis.ts, lines 283\u8211?322\par}{\pard\fs24\sa140\sl276\slmult1 Evidence is classified as uncertain, missing, partial, or matched; matching includes cited text and section. Connects assessments to the evidence distinction central to the system.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0283  export function classifyEvidence(resumeText: string, requirement: Requirement): Pick<Requirement, 'status' | 'evidence' | 'section' | 'source' | 'sourceLocation' | 'method' | 'explanation'> \{\line 0284    if (requirement.id.startsWith('unmapped:')) \{\line 0285      return \{\line 0286        status: 'uncertain',\line 0287        source: 'Job description',\line 0288        sourceLocation: 'Requirement text',\line 0289        method: 'unsupported requirement',\line 0290        explanation: 'No supported taxonomy mapping is available, so this requirement cannot be matched reliably from resume text.',\line 0291      \}\line 0292    \}\line 0293    const found = findEvidence(resumeText, aliases[requirement.id] ?? [requirement.id])\line 0294    if (!found) \{\line 0295      return \{\line 0296        status: 'missing',\line 0297        source: 'No matching resume evidence found',\line 0298        sourceLocation: 'Resume text',\line 0299        method: 'complete-term search',\line 0300        explanation: `No recognizable resume evidence was found for $\{requirement.label\}.`,\line 0301      \}\line 0302    \}\line 0303    const isSkillsOnly = found.section === 'skills' || /^(skills|technical skills|competencies)\\s*:/i.test(found.excerpt)\line 0304    if (isSkillsOnly || found.excerpt.split(/\\s+/).length < 4) \{\line 0305      return \{\line 0306        status: 'partial',\line 0307        evidence: `Found \u8220?$\{found.term\}\u8221? in: \u8220?$\{found.excerpt\}\u8221?`,\line 0308        section: found.section,\line 0309        source: 'Resume skills section',\line 0310        sourceLocation: found.section,\line 0311        method: 'complete-term search with skills-list limitation',\line 0312        explanation: 'The term is listed, but the resume does not provide enough contextual evidence to treat it as demonstrated experience.',\line 0313      \}\line 0314    \}\line 0315    return \{\line 0316      status: 'matched',\line 0317      evidence: `Found \u8220?$\{found.term\}\u8221? in: \u8220?$\{found.excerpt\}\u8221?`,\line 0318      section: found.section,\line 0319      source: found.section === 'projects' ? 'Resume project text' : found.section === 'experience' ? 'Resume experience or project text' : 'Resume contextual text',\line 0320      sourceLocation: found.section,\line 0321      method: 'complete-term contextual search',\line 0322      explanation: `The resume contains contextual evidence for $\{requirement.label\}. This indicates exposure in the cited section, not a guarantee of proficiency.`,\line \par}{\pard\fs20\b\sb220\sa100 6. 06_weighted_score_and_counterfactual.ts\par}{\pard\fs19\sa100 Source: lib/analysis.ts, lines 333\u8211?372\par}{\pard\fs24\sa140\sl276\slmult1 Weighted state credits and score breakdown computation. Shows transparent arithmetic rather than a trained ATS prediction.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0333  export function analyzeResume(resumeText: string, jobDescription: string) \{\line 0334    const requirements = extractRequirements(jobDescription).map((item) => (\{ ...item, ...classifyEvidence(resumeText, item) \}))\line 0335    const scoreBreakdown = calculateScoreBreakdown(requirements)\line 0336    const detailedRequirements = requirements.map((item) => (\{\line 0337      ...item,\line 0338      scoreContribution: \{\line 0339        credit: SCORE_WEIGHTS[item.status],\line 0340        earnedWeight: item.weight * SCORE_WEIGHTS[item.status],\line 0341        possibleWeight: item.weight,\line 0342      \},\line 0343    \}))\line 0344    return \{ taxonomyVersion: TAXONOMY_VERSION, requirements: detailedRequirements, proficiencies: estimateSkillProficiencies(resumeText), proficiencyDefinition, score: scoreBreakdown.score, scoreBreakdown, scoreDefinition \}\line 0345  \}\line 0346\line 0347  export function calculateScore(items: Requirement[]) \{\line 0348    return calculateScoreBreakdown(items).score\line 0349  \}\line 0350\line 0351  export function calculateScoreBreakdown(items: Requirement[]) \{\line 0352    const validation = validateScoringInputs(items)\line 0353    const required = items.filter((item) => item.importance === 'required')\line 0354    const preferred = items.filter((item) => item.importance === 'preferred')\line 0355    if (!validation.ok) \{\line 0356      return \{\line 0357        score: 0,\line 0358        earnedWeight: 0,\line 0359        maximumWeight: 0,\line 0360        required: summarizeStatuses(required),\line 0361        preferred: summarizeStatuses(preferred),\line 0362      \}\line 0363    \}\line 0364    const max = items.reduce((sum, item) => sum + item.weight, 0)\line 0365    const earned = items.reduce((sum, item) => sum + item.weight * SCORE_WEIGHTS[item.status], 0)\line 0366    return \{\line 0367      score: Math.round((earned / max) * 100),\line 0368      earnedWeight: earned,\line 0369      maximumWeight: max,\line 0370      required: summarizeStatuses(required),\line 0371      preferred: summarizeStatuses(preferred),\line 0372    \}\line \par}{\pard\fs20\b\sb220\sa100 7. 07_proficiency_estimate.ts\par}{\pard\fs19\sa100 Source: lib/analysis.ts, lines 177\u8211?208\par}{\pard\fs24\sa140\sl276\slmult1 Heuristic proficiency levels depend on number and type of contextual evidence, with explicit limitations. Provides evidence-bound estimates and directly disclaims verified competence.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0177  export const proficiencyDefinition = 'Deterministic evidence-supported estimates: NOT_ENOUGH_EVIDENCE means no usable evidence; FOUNDATIONAL means a skills-list, education, certification, or basic exposure signal; INTERMEDIATE means one contextual implementation or responsibility signal; ADVANCED requires at least two distinct detailed implementation or responsibility signals across relevant resume evidence. Confidence is an evidence-strength label, not a statistically calibrated probability.'\line 0178\line 0179  export function estimateSkillProficiencies(resumeText: string): SkillProficiency[] \{\line 0180    return extractSkills(resumeText).map((skill) => \{\line 0181      const evidence = collectProficiencyEvidence(resumeText, aliases[skill])\line 0182      const normalizedName = labelFor(skill)\line 0183      const contextual = evidence.filter((item) => item.signal === 'implementation-detail' || item.signal === 'professional-responsibility')\line 0184      const strong = contextual.filter((item) => item.excerpt.split(/\\s+/).length >= 7)\line 0185      let level: ProficiencyLevel = 'NOT_ENOUGH_EVIDENCE'\line 0186      let confidence: EvidenceConfidence = 'LOW'\line 0187      let explanation = `No usable evidence was found for $\{normalizedName\}.`\line 0188      let uncertainty = `The resume does not provide enough source-grounded evidence to estimate $\{normalizedName\}. This is not evidence that the skill is absent.`\line 0189      if (evidence.length > 0) \{\line 0190        if (strong.length >= 2 && new Set(strong.map((item) => `$\{item.section\}:$\{item.excerpt.toLowerCase()\}`)).size >= 2) \{\line 0191          level = 'ADVANCED'\line 0192          confidence = 'HIGH'\line 0193          explanation = `Multiple distinct detailed implementation or responsibility examples support an advanced evidence estimate for $\{normalizedName\}.`\line 0194          uncertainty = 'This remains an estimate from resume evidence, not verified real-world competence.'\line 0195        \} else if (strong.length >= 1) \{\line 0196          level = 'INTERMEDIATE'\line 0197          confidence = 'MEDIUM'\line 0198          explanation = `A detailed contextual example supports an intermediate evidence estimate for $\{normalizedName\}.`\line 0199          uncertainty = 'The resume provides one detailed example; breadth and depth beyond that example are unknown.'\line 0200        \} else \{\line 0201          level = 'FOUNDATIONAL'\line 0202          confidence = evidence.some((item) => item.signal === 'skills-list') ? 'LOW' : 'MEDIUM'\line 0203          explanation = `The resume contains $\{evidence[0].signal === 'skills-list' ? 'a skills-list mention' : 'basic exposure evidence'\} for $\{normalizedName\}, but not enough detail for a higher estimate.`\line 0204          uncertainty = 'A mention, education, certification, or basic exposure signal does not establish professional proficiency.'\line 0205        \}\line 0206      \}\line 0207      return \{ skill, normalizedName, level, confidence, explanation, evidence, uncertainty \}\line 0208    \})\line \par}{\pard\fs20\b\sb220\sa100 8. 08_hypothetical_recommendation.ts\par}{\pard\fs19\sa100 Source: lib/analysis.ts, lines 377\u8211?390\par}{\pard\fs24\sa140\sl276\slmult1 Counterfactual score replaces one requirement state with matched; recommendation text describes hypothetical score. Demonstrates bounded what-if arithmetic, not a course or real-world outcome.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0377    const earnedWeight = items.reduce((sum, item) => sum + Math.max(0, item.weight) * SCORE_WEIGHTS[item.status], 0)\line 0378    return \{\line 0379      count: items.length,\line 0380      matched: items.filter((item) => item.status === 'matched').length,\line 0381      partial: items.filter((item) => item.status === 'partial').length,\line 0382      missing: items.filter((item) => item.status === 'missing').length,\line 0383      uncertain: items.filter((item) => item.status === 'uncertain').length,\line 0384      earnedWeight,\line 0385      possibleWeight,\line 0386      weightedScore: possibleWeight ? Math.round((earnedWeight / possibleWeight) * 100) : 0,\line 0387    \}\line 0388  \}\line 0389\line 0390  export function getCounterfactualScore(items: Requirement[], requirementId: string) \{\line \par}{\pard\fs20\b\sb220\sa100 9. 09_upload_ownership_and_storage.ts\par}{\pard\fs19\sa100 Source: app/api/resumes/route.ts, lines 29\u8211?80\par}{\pard\fs24\sa140\sl276\slmult1 Authenticated upload, validation, extraction, owner-prefixed private object path, and database persistence. Traces protected file handling from API request through persistence.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0029    try \{\line 0030      const formData = await request.formData()\line 0031      const formFile = formData.get('file')\line 0032      if (!(formFile instanceof File)) return NextResponse.json(\{ error: 'Resume file is required.' \}, \{ status: 400 \})\line 0033      file = formFile\line 0034    \} catch \{\line 0035      return NextResponse.json(\{ error: 'The upload request could not be read.' \}, \{ status: 400 \})\line 0036    \}\line 0037\line 0038    if (!isSupportedResumeType(file.type)) return NextResponse.json(\{ error: 'Only PDF and DOCX resumes are supported.' \}, \{ status: 400 \})\line 0039    const validation = validateResumeFile(file)\line 0040    if (!validation.ok) return NextResponse.json(\{ error: validation.error \}, \{ status: 400 \})\line 0041\line 0042    const buffer = Buffer.from(await file.arrayBuffer())\line 0043    let extractedText: string\line 0044    try \{\line 0045      extractedText = await extractResumeText(file.type, buffer)\line 0046    \} catch (error) \{\line 0047      console.error('Resume extraction failed', \{\line 0048        filename: file.name,\line 0049        mimeType: file.type,\line 0050        size: file.size,\line 0051        error,\line 0052      \})\line 0053      const message = error instanceof Error ? error.message : ''\line 0054      return NextResponse.json(\{\line 0055        error: message.includes('enough readable text')\line 0056          ? 'We could not find enough selectable text in that resume. Please upload a text-based PDF or DOCX file.'\line 0057          : 'We could not read that resume. Please check that the file is not corrupted or password-protected.',\line 0058      \}, \{ status: 422 \})\line 0059    \}\line 0060\line 0061    const storagePath = `$\{auth.user.id\}/$\{randomUUID()\}-$\{file.name.replace(/[^a-zA-Z0-9._-]/g, '_')\}`\line 0062    const workflowToken = randomUUID()\line 0063    const supabase = await createSupabaseServerClient()\line 0064    const storageResult = await supabase.storage.from('resumes').upload(storagePath, buffer, \{ contentType: file.type, upsert: false \})\line 0065    if (storageResult.error) \{\line 0066      console.error('Resume storage persistence failed', \{ filename: file.name, error: storageResult.error \})\line 0067      return NextResponse.json(\{ error: 'The resume could not be stored securely. Please try again.' \}, \{ status: 503 \})\line 0068    \}\line 0069\line 0070    try \{\line 0071      const result = await pool.query(\line 0072        `INSERT INTO resumes (owner_id, filename, mime_type, size_bytes, extracted_text, storage_path, workflow_token) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING id, filename, created_at, workflow_token`,\line 0073        [auth.user.id, file.name, file.type, file.size, extractedText.trim(), storagePath, workflowToken],\line 0074      )\line 0075\line 0076      return NextResponse.json(\{ resume: result.rows[0] \}, \{ status: 201 \})\line 0077    \} catch (error) \{\line 0078      await supabase.storage.from('resumes').remove([storagePath]).catch((cleanupError) => console.error('Resume storage cleanup failed', cleanupError))\line 0079      console.error('Resume persistence failed', \{ filename: file.name, error \})\line 0080      return NextResponse.json(\{ error: 'The resume was extracted but could not be saved. Please try again.' \}, \{ status: 503 \})\line \par}{\pard\fs20\b\sb220\sa100 10. 10_analysis_transaction.ts\par}{\pard\fs19\sa100 Source: app/api/analyses/route.ts, lines 24\u8211?73\par}{\pard\fs24\sa140\sl276\slmult1 Authenticated ownership check, deterministic analysis, JSON result persistence, transaction and scoped cleanup. Connects server-side analysis to the owned resume and saved report.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0024  export async function POST(request: Request) \{\line 0025    const auth = await getAuthenticatedUser()\line 0026    if (!auth.user) return NextResponse.json(\{ error: auth.error === 'not_configured' ? 'Authentication is not configured.' : 'Sign in to create an analysis.' \}, \{ status: auth.error === 'not_configured' ? 503 : 401 \})\line 0027    const body = await request.json().catch(() => null)\line 0028    const resumeId = typeof body?.resumeId === 'string' ? body.resumeId.trim() : ''\line 0029    const workflowToken = typeof body?.workflowToken === 'string' ? body.workflowToken.trim() : ''\line 0030    const rawJobDescription = typeof body?.jobDescription === 'string' ? body.jobDescription : ''\line 0031    const validation = validateJobDescription(rawJobDescription)\line 0032    if (!resumeId || !validation.ok) return NextResponse.json(\{ error: !resumeId ? 'A resume is required.' : validation.error \}, \{ status: 400 \})\line 0033\line 0034    const client = await pool.connect()\line 0035    try \{\line 0036      await client.query('BEGIN')\line 0037      const resume = await client.query(`SELECT id, extracted_text FROM resumes WHERE id = $1 AND owner_id = $2 LIMIT 1`, [resumeId, auth.user.id])\line 0038      if (!resume.rows[0]) \{\line 0039        await client.query('ROLLBACK')\line 0040        return NextResponse.json(\{ error: 'Resume not found.' \}, \{ status: 404 \})\line 0041      \}\line 0042      let result\line 0043      try \{\line 0044        result = analyzeResume(resume.rows[0].extracted_text, validation.value)\line 0045      \} catch (error) \{\line 0046        await client.query('ROLLBACK')\line 0047        await cleanupFailedWorkflowResume(auth.user.id, resumeId, workflowToken)\line 0048        throw error\line 0049      \}\line 0050      const saved = await client.query(\line 0051        `INSERT INTO analyses (owner_id, resume_id, job_description, result) VALUES ($1, $2, $3, $4::jsonb) RETURNING id, resume_id, job_description, result, created_at`,\line 0052        [auth.user.id, resumeId, validation.value, JSON.stringify(result)],\line 0053      )\line 0054      await client.query('COMMIT')\line 0055      return NextResponse.json(\{ analysis: saved.rows[0] \}, \{ status: 201 \})\line 0056    \} catch (error) \{\line 0057      await client.query('ROLLBACK').catch((rollbackError) => console.error('Analysis rollback failed', rollbackError))\line 0058      await cleanupFailedWorkflowResume(auth.user.id, resumeId, workflowToken)\line 0059      console.error('Analysis persistence failed', \{ resumeId, error \})\line 0060      return NextResponse.json(\{ error: 'The analysis could not be saved. Please try again.' \}, \{ status: 503 \})\line 0061    \} finally \{\line 0062      client.release()\line 0063    \}\line 0064\line 0065    async function cleanupFailedWorkflowResume(ownerId: string, resumeId: string, workflowToken: string) \{\line 0066      if (!workflowToken) return\line 0067      try \{\line 0068        const cleanup = await pool.query(\line 0069          'DELETE FROM resumes WHERE id = $1 AND owner_id = $2 AND workflow_token = $3 RETURNING storage_path',\line 0070          [resumeId, ownerId, workflowToken],\line 0071        )\line 0072        const storagePath = cleanup.rows[0]?.storage_path\line 0073        if (storagePath) \{\line \par}{\pard\fs20\b\sb220\sa100 11. 11_research_transformations.ts\par}{\pard\fs19\sa100 Source: lib/research.ts, lines 14\u8211?55\par}{\pard\fs24\sa140\sl276\slmult1 Token baseline, limited section/order/verb transformations, and experiment execution. Supports the research harness description while exposing its actual simple transformation scope.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0014  export type ExperimentResult = \{\line 0015    executed: true\line 0016    kind: ExperimentKind\line 0017    score: number\line 0018    metrics: Record<string, number>\line 0019    output: Record<string, unknown>\line 0020  \}\line 0021\line 0022  const stopWords = new Set(['a', 'an', 'and', 'are', 'as', 'be', 'for', 'from', 'in', 'is', 'of', 'on', 'or', 'the', 'to', 'with'])\line 0023\line 0024  export function tokenize(value: string) \{\line 0025    return [...new Set(value.toLowerCase().match(/[a-z0-9][a-z0-9+#.-]*/g) ?? [])].filter((token) => !stopWords.has(token))\line 0026  \}\line 0027\line 0028  export function keywordBaseline(resumeText: string, jobDescription: string) \{\line 0029    const resumeTokens = new Set(tokenize(resumeText))\line 0030    const jobTokens = tokenize(jobDescription)\line 0031    const matched = jobTokens.filter((token) => resumeTokens.has(token))\line 0032    const score = jobTokens.length ? Math.round((matched.length / jobTokens.length) * 100) : 0\line 0033    return \{ score, matched: [...new Set(matched)], totalTerms: jobTokens.length \}\line 0034  \}\line 0035\line 0036  export function transformResume(resumeText: string, transformation: NonNullable<ExperimentConfig['transformation']>) \{\line 0037    if (transformation === 'remove_section') return resumeText.replace(/\\b(education|certifications|skills)\\b[\\s\\S]*?(?=\\n[A-Z][^\\n]\{2,40\}\\n|$)/i, '').trim()\line 0038    if (transformation === 'reorder_sections') return `$\{resumeText.split(/\\n\{2,\}/).reverse().join('\\n\\n').trim()\}\\n`\line 0039    return resumeText.split(/\\n/).map((line) => line.replace(/\\b(led|built|created|managed)\\b/gi, 'contributed to')).join('\\n')\line 0040  \}\line 0041\line 0042  export function runExperiment(config: ExperimentConfig): ExperimentResult \{\line 0043    if (!config.resumeText.trim() || !config.jobDescription.trim()) throw new Error('Resume text and job description are required')\line 0044    if (config.kind === 'baseline') \{\line 0045      const result = config.baseline === 'keyword' ? keywordBaseline(config.resumeText, config.jobDescription) : analyzeResume(config.resumeText, config.jobDescription)\line 0046      const score = result.score\line 0047      const matchedTerms = 'matched' in result ? result.matched.length : result.requirements.filter((item) => item.status === 'matched').length\line 0048      return \{ executed: true, kind: 'baseline', score, metrics: \{ score, matchedTerms \}, output: result \}\line 0049    \}\line 0050\line 0051    const baseline = analyzeResume(config.resumeText, config.jobDescription)\line 0052    const transformedText = transformResume(config.resumeText, config.transformation ?? 'reorder_sections')\line 0053    const transformed = analyzeResume(transformedText, config.jobDescription)\line 0054    const delta = transformed.score - baseline.score\line 0055    return \{ executed: true, kind: config.kind, score: transformed.score, metrics: \{ baselineScore: baseline.score, transformedScore: transformed.score, scoreDelta: delta, qualificationPreserved: transformed.requirements.filter((item) => item.status === 'matched').length >= Math.max(0, baseline.requirements.filter((item) => item.status === 'matched').length - 1) ? 1 : 0 \}, output: \{ baseline, transformed, transformation: config.transformation \} \}\line \par}{\pard\fs20\b\sb220\sa100 12. 12_forecast_readiness_gate.ts\par}{\pard\fs19\sa100 Source: lib/forecast/readiness.ts, lines 1\u8211?30\par}{\pard\fs24\sa140\sl276\slmult1 Forecast route reads a generated readiness artifact and returns unavailable on absent/insufficient status. Evidence that forecast UI is gated and should not be presented as a validated product feature.\par}{\pard\f1\fs18\sa0\sl220\slmult1 0001  import \{ readFile \} from 'node:fs/promises'\line 0002  import path from 'node:path'\line 0003\line 0004  export type ForecastReadinessResponse = \{\line 0005    error: 'forecast_unavailable'\line 0006    code: 'FORECAST_INSUFFICIENT_DATA'\line 0007    message: string\line 0008    readiness: Record<string, unknown> | null\line 0009  \}\line 0010\line 0011  export async function forecastReadiness(): Promise<ForecastReadinessResponse> \{\line 0012    const reportPath = path.join(process.cwd(), 'ml', 'skill-intelligence', 'data', 'job-postings', 'reports', 'forecasting', 'forecast_readiness.json')\line 0013    try \{\line 0014      const report = JSON.parse(await readFile(reportPath, 'utf8')) as \{ readiness?: Record<string, unknown>; forecast_support?: Record<string, unknown> \}\line 0015      return \{\line 0016        error: 'forecast_unavailable',\line 0017        code: 'FORECAST_INSUFFICIENT_DATA',\line 0018        message: String(report.forecast_support?.reason ?? 'Reliable historical data is insufficient for validated forecasting.'),\line 0019        readiness: report.readiness ?? null,\line 0020      \}\line 0021    \} catch \{\line 0022      return \{\line 0023        error: 'forecast_unavailable',\line 0024        code: 'FORECAST_INSUFFICIENT_DATA',\line 0025        message: 'Reliable historical data is insufficient for validated forecasting.',\line 0026        readiness: null,\line 0027      \}\line 0028    \}\line 0029  \}\line \par}{\pard\fs26\b\sb360\sa160 3. Screenshot evidence\par}{\pard\fs24\sa140\sl276\slmult1 The package contains authentic local-application screenshots of the sign-in and account-creation routes. They show empty forms and contain no account or user data. Protected dashboard, upload, analysis-result, and future-skill data screens are not represented because no safe non-production authenticated account was available for this capture.\par}{\pard\fs20\i\qc\sa200 Figure 2. Sign-in route (/auth/signin), captured from the locally running application with blank fields.\par}{\pard\fs20\i\qc\sa200 Figure 3. Create-account route (/auth/signup), captured from the locally running application with blank fields.\par}{\pard\fs24\sa140\sl276\slmult1 For manual capture of authenticated screens, configure a dedicated non-production Supabase project and database, create a test user, sign in at /auth/signin, capture / (dashboard), open New analysis to capture the upload interface, upload a synthetic non-personal PDF/DOCX, enter a synthetic job description, and capture the generated result and evidence panel. Capture /dashboard/forecast only to document its unavailable state; do not imply forecasts are functional. Remove test records and redact any identifiers before external distribution.\par}{\pard\fs26\b\sb360\sa160 4. Verification record\par}{\pard\fs24\sa140\sl276\slmult1 TypeScript test suite: 49 passed. Forecasting and skill-intelligence Python suites: 66 passed. ESLint: passed. Production build: passed with Webpack. No ML training was launched and no GPU or ML dependency was installed during this documentation preparation.\par}{\pard\fs24\sa140\sl276\slmult1 See verification/implementation_feature_matrix.md and verification/source_file_references.md for concise claim-to-source mappings.\par}}