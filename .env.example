# Supabase hosted PostgreSQL connection.
# Replace [YOUR-PASSWORD] with the database password from Supabase.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yrmpoadrtgzlrafgqqoq.supabase.co:5432/postgres
# Server-only Supabase CA certificate from Dashboard > Database Settings > SSL Configuration.
# Use either this escaped-newline value or DATABASE_CA_CERT_PATH, not both.
SUPABASE_DB_CA_CERT=-----BEGIN CERTIFICATE-----\n[SUPABASE-CA-CERTIFICATE]\n-----END CERTIFICATE-----
# Optional server-only path to the downloaded Supabase CA certificate.
# Use a deployment-specific path only when the certificate is mounted there.
DATABASE_CA_CERT_PATH=

# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://yrmpoadrtgzlrafgqqoq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only. Never expose this value to browser code.
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://yrmpoadrtgzlrafgqqoq.supabase.co/auth/v1/.well-known/jwks.json

# Optional live RLS and Storage audit accounts.
# Use two dedicated non-production Supabase users only.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
